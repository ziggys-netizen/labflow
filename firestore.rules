rules_version = '2';

// LabFlow — INTERIM lockdown ruleset
// Base: Cursor's U1 (repo firestore.rules), which is the authoritative version.
// Change from U1: an approved() gate on every clinic-scoped read and write.
//
// Why: under U1 as written, a pending user who self-sets clinicId through the
// client join write could immediately read that clinic's patients — before any
// admin approved them. That defeats the approval step in PRD §4.2. Anyone
// holding a join code got the patient list.
//
// Everything else is U1 unchanged: clinicPins and nonconformingEvents stay
// clinic-scoped because the app writes them; preApprovals stay client-deny;
// users list is clinic-scoped; self-create locks clinicId and clinicRoles.
//
// NOT the final R4 ruleset. Identity is users/{uid} via get(), no custom
// claims. Replaced after Stage B (OIDC) is complete.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------

    function signedIn() {
      return request.auth != null;
    }

    function callerUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(callerUserPath());
    }

    function userDoc() {
      return get(callerUserPath()).data;
    }

    // CHANGED FROM U1 — the approval gate.
    function isApproved() {
      return userExists() && userDoc().get("status", "") == "approved";
    }

    function isOwner() {
      return userExists() && userDoc().get("role", "") == "owner";
    }

    function userClinic() {
      return userExists() ? userDoc().get("clinicId", null) : null;
    }

    // CHANGED FROM U1 — a clinic admin must also be approved.
    function isClinicAdmin() {
      return userExists()
             && isApproved()
             && userDoc().get("role", "") == "clinic_admin";
    }

    // Accounts officers may not read or write clinical records. They read
    // dailyTestValueRollups only. Totals must not become a patient access path.
    function isAccountsOfficer() {
      return isApproved() && userDoc().get("role", "") == "accounts";
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasClinicId(data) {
      return data.keys().hasAll(["clinicId"])
             && data.clinicId is string
             && data.clinicId.size() > 0;
    }

    function clinicIdUnchanged() {
      return request.resource.data.get("clinicId", null) == resource.data.get("clinicId", null);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- clinic scoping ----------
    // isOwner() is always evaluated first: owner has clinicId == null.
    // CHANGED FROM U1 — isApproved() added to every non-owner branch.

    function clinicScopedGet(data) {
      return isOwner()
             || (isApproved()
                 && userClinic() != null
                 && data.get("clinicId", null) == userClinic());
    }

    function clinicScopedWrite() {
      return isOwner()
             || (isApproved()
                 && userClinic() != null
                 && request.resource.data.clinicId == userClinic());
    }

    function userInCallerClinic(data) {
      return userClinic() != null
             && (
               data.get("clinicId", null) == userClinic()
               || (
                 data.get("clinicIds", []) is list
                 && data.get("clinicIds", []).hasAny([userClinic()])
               )
             );
    }

    // ---------- owner-role protection ----------

    function nestedRole(cid) {
      return cid is string
             && request.resource.data.get("clinicRoles", {}).get(cid, {}).get("role", "") == "owner";
    }

    function nestedRoleWasOwner(cid) {
      return cid is string
             && resource.data.get("clinicRoles", {}).get(cid, {}).get("role", "") == "owner";
    }

    function setsOwnerRole() {
      return (
               request.resource.data.get("role", "") == "owner"
               && resource.data.get("role", "") != "owner"
             )
             || (nestedRole(request.resource.data.get("clinicId", null))
                 && !nestedRoleWasOwner(request.resource.data.get("clinicId", null)))
             || (nestedRole(request.resource.data.get("activeClinicId", null))
                 && !nestedRoleWasOwner(request.resource.data.get("activeClinicId", null)))
             || (nestedRole(userClinic()) && !nestedRoleWasOwner(userClinic()));
    }

    // ---------- users ----------

    function clinicIdCurrentlyNull() {
      return !("clinicId" in resource.data) || resource.data.clinicId == null;
    }

    function selfCreateOk(uid) {
      return signedIn()
             && request.auth.uid == uid
             && (!("role" in request.resource.data) || request.resource.data.role == "pending")
             && request.resource.data.get("role", "") != "owner"
             && (!("clinicId" in request.resource.data) || request.resource.data.clinicId == null)
             && request.resource.data.get("clinicRoles", {}).size() == 0;
    }

    function selfUpdateOk(uid) {
      return signedIn()
             && request.auth.uid == uid
             && changedKeys().hasOnly(["username", "usernameUpdatedAt", "activeClinicId", "clinicId"])
             && (
               !changedKeys().hasAny(["clinicId"])
               || clinicIdCurrentlyNull()
             );
    }

    function staffUserUpdateOk() {
      return isOwner()
             || (isClinicAdmin() && userInCallerClinic(resource.data));
    }

    match /users/{uid} {
      allow get: if isSelf(uid)
                 || isOwner()
                 || (isClinicAdmin() && userInCallerClinic(resource.data));

      allow list: if isOwner()
                  || (isClinicAdmin() && userInCallerClinic(resource.data));

      // Do not get() users/$(uid) here — the document does not exist yet.
      allow create: if selfCreateOk(uid);

      allow update: if !setsOwnerRole()
                    && (selfUpdateOk(uid) || staffUserUpdateOk());

      allow delete: if false;
    }

    // ---------- clinics ----------
    // Known disclosure pending R4: any signed-in user may get and list clinics,
    // including joinCode queries, because rules cannot see query filters.
    // Unauthenticated is still denied.
    //
    // Retention: new clinics must record period + basis (clinic-written; no
    // product default). Existing docs without those keys stay readable.
    // Updates may omit the keys until the clinic sets them; once set they
    // cannot be cleared. Empty strings are not a recorded choice.
    // Deletion/purge after the period is not enforced here.

    function validClinicRetention(data) {
      return data.keys().hasAll(["retentionPeriod", "retentionBasis"])
             && data.retentionPeriod is string
             && data.retentionPeriod.size() > 0
             && data.retentionBasis is string
             && data.retentionBasis.size() > 0;
    }

    function clinicRetentionWriteOk() {
      return validClinicRetention(request.resource.data)
             || (
               !validClinicRetention(resource.data)
               && !request.resource.data.keys().hasAny(["retentionPeriod"])
               && !request.resource.data.keys().hasAny(["retentionBasis"])
             );
    }

    match /clinics/{clinicId} {
      allow get, list: if signedIn();
      allow create: if isOwner() && validClinicRetention(request.resource.data);
      allow update: if (isOwner()
                    || (isClinicAdmin() && userClinic() == clinicId))
                    && clinicRetentionWriteOk();
      allow delete: if isOwner();
    }

    // ---------- clinical and operational records ----------
    // CHANGED FROM U1 — these now require isApproved() via clinicScoped*().

    function clinicalGet() {
      return clinicScopedGet(resource.data);
    }

    function clinicalList() {
      return clinicScopedGet(resource.data);
    }

    function clinicalCreate() {
      return hasClinicId(request.resource.data) && clinicScopedWrite();
    }

    function clinicalUpdate() {
      return hasClinicId(request.resource.data)
             && clinicIdUnchanged()
             && clinicScopedGet(resource.data);
    }

    // Clinical lists (patients, orders, results, catalogue, store). Accounts
    // are excluded: they must not get() or list() orders or patients.
    function patientDataGet() {
      return clinicScopedGet(resource.data) && !isAccountsOfficer();
    }

    function patientDataCreate() {
      return clinicalCreate() && !isAccountsOfficer();
    }

    function patientDataUpdate() {
      return clinicalUpdate() && !isAccountsOfficer();
    }

    match /patients/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /orders/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /testCatalog/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /inventoryItems/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /inventoryBatches/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /inventoryMovements/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /specimenMovements/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    match /nonconformingEvents/{id} {
      allow get: if patientDataGet();
      allow list: if patientDataGet();
      allow create: if patientDataCreate();
      allow update: if patientDataUpdate();
      allow delete: if false;
    }

    // ---------- daily test-value rollups ----------
    // Aggregate only. Written at result release by lab_manager / lab_supervisor
    // / owner. Accounts officers may get/list this collection and nothing
    // clinical — no drill-down from totals into patients or orders.
    //
    // Assumed document:
    //   dailyTestValueRollups/{clinicId}_{yyyy-mm-dd}
    //   clinicId: string
    //   date: yyyy-mm-dd
    //   testCount: number >= 0
    //   valueOfTestsOrdered: number >= 0  (catalogue price; not revenue)
    //   byTest: map of { code, name, count, value }
    //   updatedAt: string
    // No patientId, patientLabId, patientName, orderId, or results.

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function isValidDailyTestValueRollup(data) {
      return hasClinicId(data)
             && data.keys().hasOnly(["clinicId", "date", "testCount", "valueOfTestsOrdered", "byTest", "updatedAt"])
             && data.clinicId.size() <= 128
             && data.date is string
             && data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
             && data.updatedAt is string
             && data.updatedAt.size() > 0
             && data.updatedAt.size() <= 40
             && isNonNegativeNumber(data.testCount)
             && isNonNegativeNumber(data.valueOfTestsOrdered)
             && data.byTest is map
             && data.byTest.size() <= 200;
    }

    function rollupIdMatches(id, data) {
      return id == data.clinicId + "_" + data.date;
    }

    function canWriteDailyRollup() {
      return isOwner()
             || (isApproved() && userDoc().get("role", "") in ["lab_manager", "lab_supervisor"]);
    }

    function canReadDailyRollup() {
      return isOwner()
             || (isApproved() && userDoc().get("role", "") in ["accounts", "clinic_admin"]);
    }

    match /dailyTestValueRollups/{rollupId} {
      allow get, list: if canReadDailyRollup() && clinicScopedGet(resource.data);

      allow create: if canWriteDailyRollup()
                    && isValidDailyTestValueRollup(request.resource.data)
                    && rollupIdMatches(rollupId, request.resource.data)
                    && clinicScopedWrite();

      allow update: if canWriteDailyRollup()
                    && isValidDailyTestValueRollup(request.resource.data)
                    && rollupIdMatches(rollupId, request.resource.data)
                    && clinicIdUnchanged()
                    && request.resource.data.date == resource.data.date
                    && clinicScopedGet(resource.data)
                    && clinicScopedWrite();

      allow delete: if false;
    }

    // ---------- audit log ----------
    // Create only. Never updated, never deleted, by anyone including owner.

    match /auditLogs/{id} {
      allow get, list: if isOwner()
                       || (isClinicAdmin()
                           && userClinic() != null
                           && resource.data.clinicId == userClinic());

      // CHANGED FROM U1 — approved gate via clinicScopedWrite().
      allow create: if hasClinicId(request.resource.data) && clinicScopedWrite();

      allow update, delete: if false;
    }

    // ---------- staff PINs ----------
    // PINs are set after approval (PRD §4.2 step 8), so approved() applies.

    match /clinicPins/{id} {
      allow get, list: if clinicScopedGet(resource.data);

      allow create, update: if hasClinicId(request.resource.data)
                            && (
                              isOwner()
                              || (
                                isApproved()
                                && userClinic() != null
                                && request.resource.data.clinicId == userClinic()
                                && (
                                  request.resource.data.get("uid", "") == request.auth.uid
                                  || isClinicAdmin()
                                )
                              )
                            );

      allow delete: if isOwner() || isClinicAdmin();
    }

    // ---------- usernames ----------
    // Single-document reads only, so the collection cannot be enumerated.

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- migration history ----------

    match /migrationHistory/{id} {
      allow get, list: if isOwner()
                       || (
                         isApproved()
                         && userClinic() != null
                         && resource.data.clinicId == userClinic()
                         && userDoc().get("role", "") in ["lab_manager", "clinic_admin"]
                       );

      allow create: if isOwner()
                    || (
                      isApproved()
                      && userClinic() != null
                      && request.resource.data.clinicId == userClinic()
                      && userDoc().get("role", "") == "lab_manager"
                    );

      allow update, delete: if false;
    }

    // ---------- roster ----------
    // Recurrence is NOT evaluated here. Rostered access is the same category
    // as the PIN: attribution and deliberate friction, not a security
    // boundary (PRD §5.2.1). Evaluating patterns in rules would multiply
    // get() calls and still lose to a spoofed device clock. Queued clinical
    // writes that sync outside a window must still succeed — rejecting them
    // would lose a clinical record to a scheduling rule.

    function rosterManage() {
      return isOwner() || isClinicAdmin();
    }

    match /rosterEntries/{id} {
      allow get, list: if clinicalGet();
      allow create: if hasClinicId(request.resource.data)
                    && clinicScopedWrite()
                    && rosterManage();
      allow update: if hasClinicId(request.resource.data)
                    && clinicIdUnchanged()
                    && clinicScopedGet(resource.data)
                    && rosterManage();
      allow delete: if rosterManage() && clinicScopedGet(resource.data);
    }

    // Leave / sick rows can reveal staff health — not clinic-wide readable.
    // Writes stay clinic-scoped so a clinic_admin cannot create, move, or
    // delete another clinic's exceptions. rosterEntries stay clinic-readable
    // (schedule is not health data). Recurrence is still not evaluated here.
    match /rosterExceptions/{id} {
      allow get, list: if isOwner()
                       || (isApproved() && resource.data.userUid == request.auth.uid)
                       || (isClinicAdmin()
                           && userClinic() != null
                           && resource.data.clinicId == userClinic());
      allow create: if hasClinicId(request.resource.data)
                    && clinicScopedWrite()
                    && rosterManage();
      allow update: if clinicalUpdate() && rosterManage();
      allow delete: if rosterManage() && clinicScopedGet(resource.data);
    }

    match /rosterSessions/{id} {
      allow get, list: if clinicalGet();
      allow create: if hasClinicId(request.resource.data)
                    && clinicScopedWrite()
                    && (
                      rosterManage()
                      || request.resource.data.get("userUid", "") == request.auth.uid
                    );
      allow update, delete: if rosterManage() && clinicScopedGet(resource.data);
    }

    // ---------- staff pre-approvals ----------
    // Readable by staff managers; never client-writable. Admin SDK only.

    match /preApprovals/{id} {
      allow get, list: if isOwner()
                       || (isClinicAdmin()
                           && userClinic() != null
                           && resource.data.clinicId == userClinic());
      allow create, update, delete: if false;
    }

    // ---------- join attempts ----------
    // Server-only. No client access of any kind.

    match /joinAttempts/{id} {
      allow read, write: if false;
    }

    // ---------- default deny ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
